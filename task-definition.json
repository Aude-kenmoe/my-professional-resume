{
  "family": "portfolio-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::885684264653:role/ecsTaskExecutionRole",
  "cpu": "256",
  "memory": "512",
  "requiresCompatibilities": ["FARGATE"],
  "containerDefinitions": [
    {
      "name": "portfolio-app",
      "image": "portfolio-app:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
